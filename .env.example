# Server only. Never use NEXT_PUBLIC_ for private keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Required in local mode; use a random secret of 32+ characters.
ANALYSIS_ACCESS_TOKEN=

# Optional distributed rate limit (recommended on Vercel production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional cloud account. Public anon/publishable key only; NEVER service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AGROVISION_PROJECT_ID=rabanitos-2026
