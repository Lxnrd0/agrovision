{
  "name": "agrovision",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:site": "node scripts/build-site.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.6",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
